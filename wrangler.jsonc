{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "machierabi-annai",
  "compatibility_date": "2026-09-23",
  "main": "worker/domain-redirect.mjs",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  }
}
